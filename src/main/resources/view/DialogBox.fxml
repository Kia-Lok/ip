<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>

<fx:root alignment="TOP_RIGHT" maxWidth="1.7976931348623157E308"
         stylesheets="@../css/dialog-box.css"
         type="javafx.scene.layout.HBox"
         xmlns="http://javafx.com/javafx/17"
         xmlns:fx="http://javafx.com/fxml/1">
    <children>
        <Label fx:id="dialog" maxWidth="390.0" minHeight="-Infinity" minWidth="0.0"
               styleClass="dialog-bubble" wrapText="true">
            <HBox.margin>
                <Insets left="6.0" right="6.0" />
            </HBox.margin>
        </Label>
    </children>
    <padding>
        <Insets bottom="5.0" top="5.0" />
    </padding>
</fx:root>
